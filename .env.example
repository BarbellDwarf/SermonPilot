# SermonPilot Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# =============================================================================
# REQUIRED — SermonAudio API
# =============================================================================
SERMONAUDIO_API_KEY=your-sermonaudio-api-key
SERMONAUDIO_BROADCASTER_ID=your-broadcaster-id

# =============================================================================
# LLM PROVIDERS — Set at least one for AI metadata generation
# =============================================================================
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# Optional providers (uncomment as needed; see config/config.example.yaml
# for the matching ${VAR} placeholders and src/core/config.py for the full
# override list):
#ANTHROPIC_API_KEY=
#XAI_API_KEY=
#GOOGLE_API_KEY=
#GROQ_API_KEY=
# Model pins (override config without editing files):
#LLM_PROVIDER=
#OPENAI_MODEL=
#ANTHROPIC_MODEL=
#XAI_MODEL=
#GOOGLE_MODEL=
#GROQ_MODEL=
#OPENROUTER_MODEL=
# Dedicated auto-edit endpoint (see llm.operations.auto_edit in config):
#AUTO_EDIT_LLM_API_KEY=
#AUTO_EDIT_LLM_BASE_URL=

# =============================================================================
# OLLAMA — Local LLM inference (optional, run separately)
# =============================================================================
OLLAMA_HOST=http://localhost:11434
#OLLAMA_MODEL=
# =============================================================================
# TRANSCRIPTION
# =============================================================================
# Cloud transcription backends reuse the LLM keys above:
#   whisper_openai -> OPENAI_API_KEY, whisper_openrouter -> OPENROUTER_API_KEY
#TRANSCRIPTION_BACKEND=
#WHISPER_MODEL=

# =============================================================================
# AUDIO PROCESSING
# =============================================================================
#AUDIO_ENHANCEMENT_METHOD=
#AUDIO_NOISE_REDUCTION=
#AUDIO_NORMALIZE=
#AUDIO_TARGET_LEVEL=
#AUDIO_GAIN_DB=

# =============================================================================
# OUTPUT
# =============================================================================
#OUTPUT_DIRECTORY=
#SAVE_TRANSCRIPT=
#SAVE_ORIGINAL_AUDIO=

# =============================================================================
# PROCESSING BEHAVIOR
# =============================================================================
#DRY_RUN=
#DEBUG=
#VERBOSE=
#HASHTAG_VERIFICATION=
#QA_NORMALIZATION_ENABLED=

# =============================================================================
# EMBEDDINGS / RAG
# =============================================================================
#EMBEDDING_PROVIDER=
#EMBEDDING_MODEL=

# =============================================================================
# DATABASE
# =============================================================================
DATABASE_URL=sqlite:///sermon_processor.db

# =============================================================================
# SECURITY — Optional password protection
# =============================================================================
# Set APP_PASSWORD to require a password before the UI loads. Replace the
# placeholder with a strong password. Leave empty to run without
# authentication (local use only).
APP_PASSWORD=your-password-here
# Bind address for the published port. 127.0.0.1 keeps the app local-only;
# use 0.0.0.0 to expose it on the network (requires APP_PASSWORD).
HOST_BIND=127.0.0.1

# =============================================================================
# INGEST WATCHER — optional cloud-remote notify (#283)
# =============================================================================
# Polls a per-user rclone remote and sends a Signal alert when a new recording
# appears. Notify-only: nothing is downloaded or processed. The docker entry
# point starts the watcher only when INGEST_WATCHER_ENABLED is truthy; the
# remote/user_id/watch path live in the ingest_watcher config block.
#INGEST_WATCHER_ENABLED=1
# Self-hosted Signal gateway. Leave sender/recipients unset to run
# detection-only (the watcher logs "notify disabled").
#INGEST_SIGNAL_URL=http://192.168.75.22:8080
#INGEST_SIGNAL_SENDER=
#INGEST_SIGNAL_RECIPIENTS=

# =============================================================================
# DOCKER — Only used when running in containers
# =============================================================================
# Max browser upload size in megabytes (standalone runs: same variable, or edit
# .streamlit/config.toml). Default 30720 (30 GB). Large raw recordings should use
# the Server Path ingest tab instead of browser upload.
STREAMLIT_SERVER_MAX_UPLOAD_SIZE=30720
